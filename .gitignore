# Compiled class file
*.class
**/classes/

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Python bytecode
__pycache__/
*.pyc

# Legacy migration copies (pipeline reads workspace from 00-run-config.json)
JADE-4.6.0-java1.6/

# Generated workspace copies (never commit isolated workspaces)
migration-runs/*/workspace/

# Source policy test output artifacts (config JSONs are tracked)
tests/fixtures/source-policy/artifacts/

# Git worktrees (isolated workspaces)
.worktrees/

# Local tool state
.superpowers/

# Consumer build/runtime output (never commit compiled classes or JADE runtime dumps)
consumer-playground/*/build/
consumer-playground/*/target/
consumer-playground/**/APDescription.txt
consumer-playground/**/MTPs-Main-Container.txt
