FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Core test dependencies (mirror the local dev environment).
RUN pip install --no-cache-dir \
        pytest \
        jsonschema \
        tree-sitter \
        tree-sitter-java

WORKDIR /workspace

# Mount the repo read-write so migration-runs artifacts and fixtures resolve.
VOLUME ["/workspace"]

CMD ["python", "-m", "pytest", "tests/", "-q"]