{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/migration-source-catalog.schema.json",
  "title": "Migration Source Catalog",
  "oneOf": [
    {
      "$ref": "#/$defs/catalogDocument"
    },
    {
      "$ref": "#/$defs/pathDocument"
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "document_title",
        "url",
        "summary"
      ]
    },
    "citedWork": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "accessed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "accessed"
      ]
    },
    "catalogPathEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path_id": {
          "type": "string",
          "minLength": 1
        },
        "path_title": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^paths/.+\\.json$"
        }
      },
      "required": [
        "path_id",
        "path_title",
        "file"
      ]
    },
    "catalogDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_type": {
          "const": "migration_source_catalog"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "generated_from": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/catalogPathEntry"
          }
        },
        "cited_works": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citedWork"
          }
        }
      },
      "required": [
        "document_type",
        "title",
        "version",
        "generated_from",
        "paths"
      ]
    },
    "pathDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_type": {
          "const": "migration_source_path"
        },
        "path_id": {
          "type": "string",
          "minLength": 1
        },
        "path_title": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "required": [
        "document_type",
        "path_id",
        "path_title",
        "sources"
      ]
    }
  }
}
