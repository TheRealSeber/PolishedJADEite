\"input-group-btn\">\n                                                        <button type=\"submit\" class=\"btn btn-default\" aria-label=\"Submit Search Query\">\n                                                            <span class=\"glyphicon glyphicon-search\" aria-hidden=\"true\"></span>\n                                                            <span class=\"sr-only\">Search</span>\n                                                        </button>\n                                                    </span>\n                                                </div>\n                                            </div>\n                                            <input type=\"hidden\" name=\"category\" value=\"java\">\n                                            <input type=\"hidden\" name=\"product\" value=\"en/java/javase/26\">\n                                        </form>\n        \n                                        <ul class=\"nav navbar-nav visible-xs-block\">\n                                                <li><a href=\"index.html\">Home</a></li>\n                                                \n                                                <li><a href=\"/en/java/javase/26/docs/api/overview-summary.html\">API Documentation</a></li>\n                                                \n                                                <li><a href=\"books.html\">Guides</a></li>\n                                                \n                                                <li><a href=\"related-resources.html\">Related Resources</a></li>\n                                                \n                                        </ul>\n        \n                                    </div>\n                                </div>\n                            </nav>\n                        </div>\n                    </div>\n        \n                    <main>\n                        <div>\n                            <div class=\"ohc-grid\">\n     